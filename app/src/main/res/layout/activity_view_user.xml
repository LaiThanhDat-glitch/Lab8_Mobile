<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:padding="16dp"
    tools:context=".ViewUserActivity">

  <!-- Bố cục hàng ngang (Horizontal) chia làm 2 bên theo sơ đồ trên bảng -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:weightSum="10">

    <!-- CỘT BÊN TRÁI: Hiển thị Username, Email, Desc, Hobby,... -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="6"
        android:orientation="vertical"
        android:paddingEnd="12dp">

      <!-- Tên user (User 1) -->
      <TextView
          android:id="@+id/tv_detail_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="User 1"
          android:textColor="#00E5FF"
          android:textSize="22sp"
          android:textStyle="bold" />

      <!-- Toàn bộ chi tiết: Email, Description, Hobby,... -->
      <TextView
          android:id="@+id/tv_detail_description"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:lineSpacingExtra="6dp"
          android:text="Email\n...\n...\n..."
          android:textColor="#FF9100"
          android:textSize="16sp" />

    </LinearLayout>

    <!-- CỘT BÊN PHẢI: Hiển thị ảnh avatar lớn -->
    <ImageView
        android:id="@+id/iv_detail"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_weight="4"
        android:scaleType="centerCrop"
        android:contentDescription="Avatar"
        tools:srcCompat="@tools:sample/avatars" />

  </LinearLayout>

</ScrollView>